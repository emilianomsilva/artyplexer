{
  "name": "artyplexer",
  "version": "0.1.0",
  "description": "Lightweight desktop multiplexer for WhatsApp, Telegram and messaging tools — Electron + Rust edition",
  "main": "electron/main.js",
  "author": {
    "name": "Artyplexer",
    "email": "artyplexer@localhost"
  },
  "homepage": "https://github.com/emilianomsilva/artyplexer",
  "scripts": {
    "start": "electron .",
    "build-frontend": "npm --prefix frontend run build",
    "build-rust": "cargo build --release --manifest-path rust-helper/Cargo.toml",
    "build": "npm run build-frontend && npm run build-rust && npm run build-icon",
    "pack": "npm run build && electron-builder --linux dir",
    "dist": "npm run build && electron-builder --linux deb",
    "smoke": "node scripts/smoke.js",
    "test": "node --test tests/*.test.js && npm run smoke",
    "build-icon": "node scripts/make-icon.js",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.artyplexer.app",
    "productName": "Artyplexer",
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "dir",
        "deb"
      ],
      "maintainer": "Artyplexer <artyplexer@localhost>",
      "category": "Network;InstantMessaging;Chat",
      "icon": "build/icon.png",
      "executableName": "artyplexer",
      "extraResources": [
        {
          "from": "rust-helper/target/release/artyplexer-media",
          "to": "artyplexer-media"
        }
      ]
    },
    "icon": "build/icon.png",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.social-networking",
      "artifactName": "Artyplexer-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Artyplexer uses the camera when you start a video call in a web service.",
        "NSMicrophoneUsageDescription": "Artyplexer uses the microphone for calls and voice messages in web services."
      },
      "extraResources": [
        {
          "from": "rust-helper/target/release/artyplexer-media",
          "to": "artyplexer-media"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "executableName": "artyplexer",
      "extraResources": [
        {
          "from": "rust-helper/target/release/artyplexer-media.exe",
          "to": "artyplexer-media.exe"
        }
      ]
    }
  },
  "desktopName": "artyplexer.desktop"
}
